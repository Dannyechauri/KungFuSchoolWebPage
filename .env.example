# Configuración que usa `npm run dev` únicamente en tu ordenador.
# Copia este archivo como .env.dev.local y completa solo lo necesario.
# No uses VITE_ para estas variables: son credenciales del servidor, no del navegador.

# PostgreSQL local. El lanzador solo acepta localhost o 127.0.0.1.
DEV_DB_HOST=127.0.0.1
DEV_DB_PORT=5432

# En macOS suele coincidir con tu usuario del sistema. En Windows suele ser postgres.
# DEV_DB_USER=postgres

# Déjalo vacío si tu usuario de PostgreSQL no tiene contraseña.
# DEV_DB_PASSWORD=

# Opcional: ruta a Java 21 si no está disponible desde la terminal.
# DEV_JAVA_HOME=C:\Program Files\Java\jdk-21
